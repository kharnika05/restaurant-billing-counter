# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Environment Variables & Secrets (Keep private, use .env.example)
.env
.env.local
.env.*.local
*.env

# IDE / Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Node.js / Frontend Artifacts
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Maven Artifacts
target/
**/target/
*.class
*.jar
*.war
*.ear
*.log
logs/
**/logs/

# AI IDE / Scratch Artifacts
.system_generated/
.gemini/
scratch/
